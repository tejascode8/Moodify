# ==============================================================================
# Moodify Backend Environment Variables
# ==============================================================================

# Port the backend server listens on (default: 3000)
PORT=3000

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/Moodify)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Moodify?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication & Token Signing
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Redis Cloud / Upstash Configuration for Session Caching & Token Blacklisting
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=19186
REDIS_PASSWORD=your_redis_password_here

# ImageKit Media Storage Credentials (Audio & Poster Uploads)
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key_here

# Frontend Application Origin for CORS Policy
FRONTEND_URL=http://localhost:5173

# Application Environment Mode ('development' | 'production')
NODE_ENV=development
